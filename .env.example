# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# KONFIGURASI LOG MASUK ADMIN CRM (SERVER-SIDE ONLY)
# ==============================================================================
# Tukar kredensial ini sebelum deploy ke produksi.
# Jangan gunakan awalan VITE_ supaya kata laluan tidak terdedah kepada pelayar.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="gis-admin-password"
ADMIN_SESSION_SECRET="tukar-kepada-kunci-rawak-panjang-di-produksi"

# ==============================================================================
# KONFIGURASI CRM & PENGHANTARAN PROSPEK (LEADS)
# ==============================================================================
# Emel penerima notifikasi pendaftaran minat (digunakan di frontend)
VITE_NOTIFY_EMAIL="awatifosman86@gmail.com"

# Pilihan (Server-Side Only): Sambungkan ke Webhook CRM luar seperti HubSpot,
# Airtable, Make.com, Zapier, atau Google Apps Script Web App.
CRM_PROVIDER_NAME="GIS CRM"
CRM_WEBHOOK_URL=""
CRM_API_KEY=""
